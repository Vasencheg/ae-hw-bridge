# /etc/udev/rules.d/99-hw-puppet.rules
# Udev rules for HW-PUPPET Dual CDC Composite Device (ESP32-S3)

# CDC 0: Control Channel (MicroPython REPL & Raw REPL RPC)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4002", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="hw-puppet-control", MODE="0666"

# CDC 1: Hardware UART Bridge (Transparent target console @ up to 921600+ baud)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="4002", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hw-puppet-uart", MODE="0666"
